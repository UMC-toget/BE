# Database Configuration
DB_USER=
DB_PW=
DB_URL=

# JWT Configuration
JWT_SECRET=
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=1209600

# Encryption Key (32 bytes string for AES GCM)
ENCRYPTION_KEY=

# Admin Account (배경/캐릭터 등 마스터 데이터 관리 전용 계정)
# 미설정 시 관리자 전용 API는 전부 403으로 차단됨
ADMIN_EMAIL=
ADMIN_PROVIDER=GOOGLE

# OAuth Google Configuration
GOOGLE_TOKEN_INFO_URI=https://oauth2.googleapis.com/tokeninfo
GOOGLE_USER_INFO_URI=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_CLIENT_ID=

# OAuth Kakao Configuration
KAKAO_USER_INFO_URI=https://kapi.kakao.com/v2/user/me
KAKAO_TOKEN_INFO_URI=https://kapi.kakao.com/v1/user/access_token_info
KAKAO_APP_ID=

# 웹 사진 검색 (Pexels API)
# 프론트에 키를 노출하지 않기 위한 서버 프록시(/api/v1/images/search)용.
# 미설정 시 검색 API만 503으로 응답하고, 나머지 기능은 정상 동작한다.
# 키 발급: https://www.pexels.com/api/ (가입 후 즉시 발급, 무료)
PEXELS_API_KEY=
PEXELS_API_URI=https://api.pexels.com/v1/search
PEXELS_LOCALE=ko-KR

# AWS S3 Configuration
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=toget-bucket-dev

# Bank Icon Configuration
# 은행 아이콘이 올라간 S3 디렉터리 URL — BankSeeder가 "base-url/{은행코드}.svg"로 조합한다.
# 미설정 시 banks.icon_url은 null로 남고, 아이콘 업로드 후 값을 채워 재기동하면 자동 백필된다.
# 예: https://toget-bucket-dev.s3.ap-northeast-2.amazonaws.com/bank-icons/v1
BANK_ICON_BASE_URL=
BANK_ICON_EXTENSION=svg

